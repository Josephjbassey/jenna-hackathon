# ─── Jenna AI Assistant Unified Environment Configuration ────────────────────
# Copy to .env and configure your secrets. Never commit real keys.

# ─── Meta Model API (SAM 3.1, Muse Spark 1.3, Muse Code) ───────────────────
META_MODEL_API_KEY=
META_MODEL_API_BASE=https://api.meta.ai/v1

# ─── FastAPI Backend Settings ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./memory/cross_agent.db

# ─── Next.js Frontend Settings ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ASSISTANT_NAME="Jenna AI Assistant"

# ─── GPU & Serverless Inference (Optional) ─────────────────────────────────
MODAL_API_TOKEN_ID=
MODAL_API_TOKEN_SECRET=
FIREWORKS_API_KEY=
BASETEN_API_KEY=

# ─── Observability & Tracing ───────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=jenna-hackathon

# ─── Tools & Search ────────────────────────────────────────────────────────
TAVILY_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# ─── Voice & Communications ────────────────────────────────────────────────
GOOGLE_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
