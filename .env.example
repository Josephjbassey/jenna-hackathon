# Copy to .env and chmod 600. Never commit real keys.

# ─── Meta Model API (Hackathon) ──────────────────────────────────────────
META_MODEL_API_KEY=
META_MODEL_API_BASE=https://ai.meta.com/api

# ─── Modal (GPU inference) ────────────────────────────────────────────────
MODAL_API_TOKEN_ID=
MODAL_API_TOKEN_SECRET=

# ─── Fireworks (Serverless inference) ─────────────────────────────────────
FIREWORKS_API_KEY=

# ─── Baseten (TPM rate limit) ─────────────────────────────────────────────
BASETEN_API_KEY=

# ─── LangSmith (Observability) ────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=jenna-hackathon

# ─── Tavily (Web search) ──────────────────────────────────────────────────
TAVILY_API_KEY=

# ─── Local Providers ───────────────────────────────────────────────────────
PAPERINSTRUMENTS_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=

# ─── Voice/Comms ──────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
