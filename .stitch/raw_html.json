 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=1512, initial-scale=1.0\">\n  <title>Jenna AI OS \u2014 Executive Suite</title>\n  <!-- Google Fonts: Space Grotesk, Geist Sans (via Inter fallback/system or fontCDN), JetBrains Mono -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n  <script src=\"https://unpkg.com/@phosphor-icons/web\"></script>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    @font-face {\n      font-family: 'Geist Sans';\n      src: local('Geist Sans'), local('Geist'), local('-apple-system'), local('BlinkMacSystemFont'), local('Segoe UI');\n      font-weight: 400 600;\n    }\n\n    :root {\n      --bg-base: #0A0B0D;\n      --bg-surface: #101215;\n      --bg-raised: #15181C;\n      --hairline: rgba(255, 255, 255, 0.07);\n      --hairline-strong: rgba(255, 255, 255, 0.13);\n      --ink-1: #F2F4F7;\n      --ink-2: #9AA3AE;\n      --ink-3: #5C6570;\n      --crimson: #DC143C;\n      --idle: #3F4750;\n      --listening: #22D3EE;\n      --thinking: #F59E0B;\n      --speaking: #10B981;\n      --error: #EF4444;\n    }\n\n    * {\n      box-sizing: border-box;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    body {\n      background-color: var(--bg-base);\n      color: var(--ink-1);\n      font-family: 'Geist Sans', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      overflow: hidden;\n      user-select: none;\n      height: 100vh;\n      width: 100vw;\n      margin: 0;\n      padding: 0;\n    }\n\n    .font-mono {\n      font-family: 'JetBrains Mono', monospace;\n      font-feature-settings: \"tnum\" 1;\n    }\n\n    .font-display {\n      font-family: 'Space Grotesk', sans-serif;\n      letter-spacing: 0.08em;\n    }\n\n    /* Custom thin scrollbar */\n    ::-webkit-scrollbar {\n      width: 4px;\n      height: 4px;\n    }\n    ::-webkit-scrollbar-track {\n      background: transparent;\n    }\n    ::-webkit-scrollbar-thumb {\n      background: var(--hairline-strong);\n      border-radius: 2px;\n    }\n\n    /* Avionics Audio Core Sphere animation */\n    @keyframes orbitPulse {\n      0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.9; }\n      50% { transform: scale(1.02) rotate(180deg); opacity: 1; }\n    }\n    @keyframes waveRipple {\n      0%, 100% { transform: scale(0.97); }\n      50% { transform: scale(1.03); }\n    }\n    .anim-orbit {\n      animation: orbitPulse 12s linear infinite;\n    }\n    .anim-pulse-slow {\n      animation: waveRipple 3.6s ease-in-out infinite;\n    }\n\n    /* Spectrum bars animation */\n    @keyframes spectrumAnim {\n      0%, 100% { height: 6px; }\n      25% { height: 26px; }\n      50% { height: 14px; }\n      75% { height: 34px; }\n    }\n  </style>\n</head>\n<body class=\"flex flex-col bg-[#0A0B0D] text-[#F2F4F7] text-[13px] leading-[1.45] h-screen w-screen overflow-hidden\">\n\n  <!-- ========================================================================= -->\n  <!-- ROW 1: TELEMETRY BAR (44px, full width, hairline bottom)                   -->\n  <!-- ========================================================================= -->\n  <header class=\"h-[44px] min-h-[44px] w-full bg-[#101215] border-b border-[rgba(255,255,255,0.07)] px-4 flex items-center justify-between z-30 select-none\">\n    \n    <!-- Left: Brand mark + Host badge -->\n    <div class=\"flex items-center gap-3\">\n      <div class=\"flex items-center gap-2\">\n        <span class=\"w-2 h-2 bg-[#DC143C] inline-block rounded-[1px]\"></span>\n        <span class=\"font-display font-bold text-[12px] tracking-[0.14em] text-[#F2F4F7]\">JENNA</span>\n        <span class=\"font-mono text-[10px] text-[#DC143C] bg-[#DC143C]/10 border border-[#DC143C]/30 px-1 py-[1px] rounded-[2px]\">OS v1.4</span>\n      </div>\n      <div class=\"h-3 w-[1px] bg-[rgba(255,255,255,0.07)]\"></div>\n      <div class=\"flex items-center gap-1.5 px-2 py-[2px] bg-[#15181C] border border-[rgba(255,255,255,0.07)] rounded-[3px]\">\n        <i class=\"ph ph-cpu text-[#9AA3AE] text-[12px]\"></i>\n        <span class=\"font-mono text-[11px] text-[#9AA3AE]\">Parrot \u00b7 Hyprland</span>\n        <span class=\"w-1.5 h-1.5 rounded-full bg-[#10B981] ml-0.5\"></span>\n      </div>\n    </div>\n\n    <!-- Centre: Dual-engine pills -->\n    <div class=\"flex items-center gap-2\">\n      <!-- Engine 1: Ollama -->\n      <div class=\"flex items-center gap-2 px-2.5 py-1 bg-[#15181C] border border-[rgba(255,255,255,0.07)] rounded-[4px] hover:border-[rgba(255,255,255,0.14)] transition-colors\">\n        <span class=\"w-[6px] h-[6px] rounded-full bg-[#10B981] shadow-[0_0_6px_#10B981]\"></span>\n        <span class=\"font-mono text-[11px] text-[#F2F4F7]\">Ollama :11434</span>\n        <span class=\"text-[#5C6570]\">\u00b7</span>\n        <span class=\"font-mono text-[11px] text-[#9AA3AE]\">6 models</span>\n      </div>\n\n      <!-- Engine 2: LM Studio -->\n      <div class=\"flex items-center gap-2 px-2.5 py-1 bg-[#15181C] border border-[rgba(255,255,255,0.07)] rounded-[4px] hover:border-[rgba(255,255,255,0.14)] transition-colors\">\n        <span class=\"w-[6px] h-[6px] rounded-full bg-[#10B981] shadow-[0_0_6px_#10B981]\"></span>\n        <span class=\"font-mono text-[11px] text-[#F2F4F7]\">LM Studio :1234</span>\n        <span class=\"text-[#5C6570]\">\u00b7</span>\n        <span class=\"font-mono text-[11px] text-[#9AA3AE]\">server on</span>\n      </div>\n    </div>\n\n    <!-- Right: Telemetry Meters (CPU, RAM, DISK) + Clock -->\n    <div class=\"flex items-center gap-4\">\n      <!-- CPU Meter -->\n      <div class=\"flex items-center gap-2\">\n        <span class=\"font-display text-[10px] text-[#9AA3AE]\">CPU</span>\n        <div class=\"flex flex-col gap-[2px]\">\n          <span class=\"font-mono text-[11px] text-[#F2F4F7] leading-none text-right\">34%</span>\n          <div class=\"w-[48px] h-[3px] bg-[rgba(255,255,255,0.07)] rounded-none overflow-hidden\">\n            <div class=\"h-full bg-[#10B981]\" style=\"width: 34%\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- RAM Meter (amber at 72%) -->\n      <div class=\"flex items-center gap-2\">\n        <span class=\"font-display text-[10px] text-[#9AA3AE]\">RAM</span>\n        <div class=\"flex flex-col gap-[2px]\">\n          <span class=\"font-mono text-[11px] text-[#F59E0B] leading-none text-right\">5.8/8.0 GB</span>\n          <div class=\"w-[48px] h-[3px] bg-[rgba(255,255,255,0.07)] rounded-none overflow-hidden\">\n            <div class=\"h-full bg-[#F59E0B]\" style=\"width: 72%\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- DISK Meter -->\n      <div class=\"flex items-center gap-2\">\n        <span class=\"font-display text-[10px] text-[#9AA3AE]\">DISK</span>\n        <div class=\"flex flex-col gap-[2px]\">\n          <span class=\"font-mono text-[11px] text-[#F2F4F7] leading-none text-right\">214 GB FREE</span>\n          <div class=\"w-[48px] h-[3px] bg-[rgba(255,255,255,0.07)] rounded-none overflow-hidden\">\n            <div class=\"h-full bg-[#10B981]\" style=\"width: 48%\"></div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"h-3 w-[1px] bg-[rgba(255,255,255,0.07)]\"></div>\n\n      <!-- Clock -->\n      <div class=\"flex items-center gap-1.5 pl-1\">\n        <span class=\"font-mono text-[12px] font-medium text-[#F2F4F7] tracking-tight\">20:41</span>\n        <span class=\"font-mono text-[10px] text-[#5C6570]\">UTC</span>\n      </div>\n    </div>\n  </header>\n\n  <!-- ========================================================================= -->\n  <!-- ROW 2: THREE-COLUMN ASYMMETRIC WORKSPACE (Left 296px | Center Flex | Right 336px) -->\n  <!-- ========================================================================= -->\n  <main class=\"flex-1 flex overflow-hidden relative pb-[104px]\">\n\n    <!-- ========================================== -->\n    <!-- LEFT RAIL: SQUAD ROSTER (296px)            -->\n    <!-- ========================================== -->\n    <aside class=\"w-[296px] min-w-[296px] max-w-[296px] bg-[#101215] border-r border-[rgba(255,255,255,0.07)] flex flex-col justify-between z-10\">\n      \n      <!-- Squad Roster Header -->\n      <div class=\"p-3 border-b border-[rgba(255,255,255,0.07)] flex items-center justify-between\">\n        <div class=\"flex items-center gap-2\">\n          <span class=\"font-display font-semibold text-[11px] tracking-[0.08em] text-[#9AA3AE] uppercase\">Squad Roster</span>\n          <span class=\"font-mono text-[10px] text-[#5C6570] bg-[#15181C] px-1.5 py-[1px] border border-[rgba(255,255,255,0.05)] rounded-[2px]\">5/5 ON</span>\n        </div>\n        <div class=\"flex items-center gap-1 text-[#5C6570]\">\n          <span class=\"w-1.5 h-1.5 rounded-full bg-[#10B981]\"></span>\n          <span class=\"font-mono text-[10px]\">LOCAL</span>\n        </div>\n      </div>\n\n      <!-- Agent Cards Stack -->\n      <div class=\"flex-1 overflow-y-auto px-2 py-2 flex flex-col gap-1.5\">\n\n        <!-- Card 1: Commander (idle slate) -->\n        <div class=\"relative bg-[#101215] border border-[rgba(255,255,255,0.07)] rounded-[4px] p-2.5 hover:bg-[#15181C] transition-colors cursor-pointer group\">\n          <div class=\"flex items-start justify-between\">\n            <div class=\"flex items-center gap-2\">\n              <div class=\"w-4 h-4 flex items-center justify-center text-[#9AA3AE]\">\n                <i class=\"ph ph-shield-check text-[15px]\"></i>\n              </div>\n              <span class=\"font-display font-semibold text-[11px] text-[#F2F4F7] tracking-[0.08em] uppercase\">COMMANDER</span>\n            </div>\n            <!-- Slate idle dot -->\n            <div class=\"flex items-center gap-1\">\n              <span class=\"w-[6px] h-[6px] rounded-full bg-[#3F4750]\"></span>\n            </div>\n          </div>\n          <div class=\"flex items-center justify-between mt-1.5 pl-6\">\n            <span class=\"font-mono text-[11px] text-[#9AA3AE]\">Qwen3.5-0.8B</span>\n            <span class=\"font-mono text-[10px] text-[#5C6570] border border-[rgba(255,255,255,0.07)] px-1 rounded-[2px]\">Ollama</span>\n          </div>\n          <!-- 3px bottom meter (idle) -->\n          <div class=\"absolute bottom-0 left-0 right-0 h-[3px] bg-transparent\">\n            <div class=\"h-full bg-[#3F4750]\" style=\"width: 12%\"></div>\n          </div>\n        </div>\n\n        <!-- Card 2: Engineer (emerald ready) -->\n        <div class=\"relative bg-[#101215] border border-[rgba(255,255,255,0.07)] rounded-[4px] p-2.5 hover:bg-[#15181C] transition-colors cursor-pointer group\">\n          <div class=\"flex items-start justify-between\">\n            <div class=\"flex items-center gap-2\">\n              <div class=\"w-4 h-4 flex items-center justify-center text-[#10B981]\">\n                <i class=\"ph ph-code text-[15px]\"></i>\n              </div>\n              <span class=\"font-display font-semibold text-[11px] text-[#F2F4F7] tracking-[0.08em] uppercase\">ENGINEER</span>\n            </div>\n            <!-- Emerald ready dot -->\n            <div class=\"flex items-center gap-1\">\n              <span class=\"w-[6px] h-[6px] rounded-full bg-[#10B981] shadow-[0_0_6px_#10B981]\"></span>\n            </div>\n          </div>\n          <div class=\"flex items-center justify-between mt-1.5 pl-6\">\n            <span class=\"font-mono text-[11px] text-[#9AA3AE]\">Qwen2.5-Coder-3B</span>\n            <span class=\"font-mono text-[10px] text-[#10B981] bg-[#10B981]/10 border border-[#10B981]/30 px-1 rounded-[2px]\">LM-Studio</span>\n          </div>\n          <!-- 3px bottom meter (emerald) -->\n          <div class=\"absolute bottom-0 left-0 right-0 h-[3px] bg-transparent\">\n            <div class=\"h-full bg-[#10B981]\" style=\"width: 44%\"></div>\n          </div>\n        </div>\n\n        <!-- Card 3: Planner (SELECTED, raised, 1px crimson left edge, expanded inspector) -->\n        <div class=\"relative bg-[#15181C] border border-[rgba(255,255,255,0.12)] border-l-[2px] border-l-[#DC143C] rounded-[4px] p-2.5 cursor-pointer shadow-sm\">\n          <div class=\"flex items-start justify-between\">\n            <div class=\"flex items-center gap-2\">\n              <div class=\"w-4 h-4 flex items-center justify-center text-[#DC143C]\">\n                <i class=\"ph ph-git-fork text-[15px]\"></i>\n              </div>\n              <span class=\"font-display font-semibold text-[11px] text-[#F2F4F7] tracking-[0.08em] uppercase\">PLANNER</span>\n              <span class=\"font-mono text-[9px] text-[#DC143C] uppercase px-1 border border-[#DC143C]/40 rounded-[2px]\">Active</span>\n            </div>\n            <!-- Amber thinking dot -->\n            <div class=\"flex items-center gap-1\">\n              <span class=\"w-[6px] h-[6px] rounded-full bg-[#F59E0B] shadow-[0_0_6px_#F59E0B]\"></span>\n            </div>\n          </div>\n\n          <div class=\"flex items-center justify-between mt-1.5 pl-6\">\n            <span class=\"font-mono text-[11px] text-[#F2F4F7] font-medium\">Nemotron-30B-MoE</span>\n            <span class=\"font-mono text-[10px] text-[#9AA3AE] border border-[rgba(255,255,255,0.1)] px-1 rounded-[2px]\">Ollama (Q4)</span>\n          </div>\n\n          <!-- Expanded Inline Inspector -->\n          <div class=\"mt-2.5 pt-2 border-t border-[rgba(255,255,255,0.07)] pl-2 pr-1 space-y-2\">\n            <!-- Context meter -->\n            <div>\n              <div class=\"flex items-center justify-between text-[10px] font-mono text-[#9AA3AE] mb-1\">\n                <span>context 4.2k/8k</span>\n                <span class=\"text-[#F59E0B]\">52%</span>\n              </div>\n              <div class=\"w-full h-[3px] bg-[rgba(255,255,255,0.07)] overflow-hidden\">\n                <div class=\"h-full bg-[#F59E0B]\" style=\"width: 52%\"></div>\n              </div>\n            </div>\n\n            <!-- Prompt hash + action -->\n            <div class=\"flex items-center justify-between pt-1\">\n              <div class=\"flex items-center gap-1 text-[10px] font-mono text-[#5C6570]\">\n                <span>hash:</span>\n                <span class=\"text-[#9AA3AE]\">0x9f2ac1</span>\n              </div>\n              <!-- Ghost button -->\n              <button class=\"px-2 py-[3px] text-[10px] font-mono text-[#F2F4F7] bg-transparent border border-[rgba(255,255,255,0.14)] hover:border-[#DC143C] hover:text-[#DC143C] rounded-[2px] transition-colors\">\n                Force delegate\n              </button>\n            </div>\n          </div>\n\n          <!-- 3px bottom meter -->\n          <div class=\"absolute bottom-0 left-0 right-0 h-[3px] bg-transparent\">\n            <div class=\"h-full bg-[#DC143C]\" style=\"width: 82%\"></div>\n          </div>\n        </div>\n\n        <!-- Card 4: Scholar (cyan listening) -->\n        <div class=\"relative bg-[#101215] border border-[rgba(255,255,255,0.07)] rounded-[4px] p-2.5 hover:bg-[#15181C] transition-colors cursor-pointer group\">\n          <div class=\"flex items-start justify-between\">\n            <div class=\"flex items-center gap-2\">\n              <div class=\"w-4 h-4 flex items-center justify-center text-[#22D3EE]\">\n                <i class=\"ph ph-books text-[15px]\"></i>\n              </div>\n              <span class=\"font-display font-semibold text-[11px] text-[#F2F4F7] tracking-[0.08em] uppercase\">SCHOLAR</span>\n            </div>\n            <!-- Cyan listening dot -->\n            <div class=\"flex items-center gap-1\">\n              <span class=\"w-[6px] h-[6px] rounded-full bg-[#22D3EE] shadow-[0_0_6px_#22D3EE]\"></span>\n            </div>\n          </div>\n          <div class=\"flex items-center justify-between mt-1.5 pl-6\">\n            <span class=\"font-mono text-[11px] text-[#9AA3AE]\">Ministral-3B</span>\n            <span class=\"font-mono text-[10px] text-[#22D3EE] bg-[#22D3EE]/10 border border-[#22D3EE]/30 px-1 rounded-[2px]\">Ollama</span>\n          </div>\n          <!-- 3px bottom meter (cyan) -->\n          <div class=\"absolute bottom-0 left-0 right-0 h-[3px] bg-transparent\">\n            <div class=\"h-full bg-[#22D3EE]\" style=\"width: 28%\"></div>\n          </div>\n        </div>\n\n        <!-- Card 5: Communicator (amber thinking) -->\n        <div class=\"relative bg-[#101215] border border-[rgba(255,255,255,0.07)] rounded-[4px] p-2.5 hover:bg-[#15181C] transition-colors cursor-pointer group\">\n          <div class=\"flex items-start justify-between\">\n            <div class=\"flex items-center gap-2\">\n              <div class=\"w-4 h-4 flex items-center justify-center text-[#F59E0B]\">\n                <i class=\"ph ph-chat-centered-dots text-[15px]\"></i>\n              </div>\n              <span class=\"font-display font-semibold text-[11px] text-[#F2F4F7] tracking-[0.08em] uppercase\">COMMUNICATOR</span>\n            </div>\n            <!-- Amber thinking dot -->\n            <div class=\"flex items-center gap-1\">\n              <span class=\"w-[6px] h-[6px] rounded-full bg-[#F59E0B] shadow-[0_0_6px_#F59E0B]\"></span>\n            </div>\n          </div>\n          <div class=\"flex items-center justify-between mt-1.5 pl-6\">\n            <span class=\"font-mono text-[11px] text-[#9AA3AE]\">AgentPhone + Mail</span>\n            <span class=\"font-mono text-[10px] text-[#5C6570] border border-[rgba(255,255,255,0.07)] px-1 rounded-[2px]\">ToolMesh</span>\n          </div>\n          <!-- 3px bottom meter (amber) -->\n          <div class=\"absolute bottom-0 left-0 right-0 h-[3px] bg-transparent\">\n            <div class=\"h-full bg-[#F59E0B]\" style=\"width: 65%\"></div>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- Rail Footer: Ghost Button \"New delegation\" -->\n      <div class=\"p-3 border-t border-[rgba(255,255,255,0.07)] bg-[#101215]\">\n        <button class=\"w-full h-8 flex items-center justify-center gap-2 bg-transparent border border-[rgba(255,255,255,0.13)] hover:border-[#DC143C] hover:text-[#DC143C] text-[#F2F4F7] font-mono text-[12px] rounded-[4px] transition-colors\">\n          <i class=\"ph ph-plus text-[12px]\"></i>\n          <span>New delegation</span>\n        </button>\n      </div>\n    </aside>\n\n    <!-- ========================================== -->\n    <!-- CENTER STAGE: AUDIO CORE & TRANSCRIPT      -->\n    <!-- Flexible, breathing room, biased left      -->\n    <!-- ========================================== -->\n    <section class=\"flex-1 flex flex-col justify-between px-8 py-5 relative overflow-hidden bg-[#0A0B0D]\">\n\n      <!-- Top row: Thinking-trace chips (LangGraph) -->\n      <div class=\"flex items-center justify-between z-10\">\n        <div class=\"flex items-center gap-2\">\n          <span class=\"font-display font-semibold text-[10px] tracking-[0.08em] text-[#5C6570] uppercase\">EXECUTION TRACE</span>\n          <span class=\"h-3 w-[1px] bg-[rgba(255,255,255,0.07)]\"></span>\n          <div class=\"flex items-center gap-1.5\">\n            <!-- Chip 1: retrieve (complete: crimson outline) -->\n            <div class=\"flex items-center gap-1 px-2.5 py-[3px] rounded-[3px] border border-[#DC143C] bg-[#DC143C]/10\">\n              <i class=\"ph ph-check text-[10px] text-[#DC143C]\"></i>\n              <span class=\"font-mono text-[10px] font-medium text-[#F2F4F7]\">retrieve</span>\n            </div>\n            <i class=\"ph ph-caret-right text-[10px] text-[#5C6570]\"></i>\n\n            <!-- Chip 2: plan (current: 14% amber fill) -->\n            <div class=\"flex items-center gap-1.5 px-2.5 py-[3px] rounded-[3px] border border-[#F59E0B] bg-[#F59E0B]/15\">\n              <span class=\"w-1.5 h-1.5 rounded-full bg-[#F59E0B] animate-pulse\"></span>\n              <span class=\"font-mono text-[10px] font-medium text-[#F59E0B]\">plan</span>\n            </div>\n            <i class=\"ph ph-caret-right text-[10px] text-[#5C6570]\"></i>\n\n            <!-- Chip 3: delegate (pending: ink-3) -->\n            <div class=\"flex items-center gap-1 px-2 py-[3px] rounded-[3px] border border-[rgba(255,255,255,0.07)] bg-[#101215]\">\n              <span class=\"font-mono text-[10px] text-[#5C6570]\">delegate</span>\n            </div>\n            <i class=\"ph ph-caret-right text-[10px] text-[#5C6570]\"></i>\n\n            <!-- Chip 4: verify (pending: ink-3) -->\n            <div class=\"flex items-center gap-1 px-2 py-[3px] rounded-[3px] border border-[rgba(255,255,255,0.07)] bg-[#101215]\">\n              <span class=\"font-mono text-[10px] text-[#5C6570]\">verify</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- Latency / Inference telemetry badge -->\n        <div class=\"flex items-center gap-2 font-mono text-[11px] text-[#5C6570]\">\n          <span>EVAL: <span class=\"text-[#9AA3AE]\">18.4 tok/s</span></span>\n          <span>\u00b7</span>\n          <span>TTFT: <span class=\"text-[#9AA3AE]\">140ms</span></span>\n        </div>\n      </div>\n\n      <!-- Center Sphere: 320px particle/noise displaced sphere (biased slightly left) -->\n      <div class=\"my-auto flex flex-col items-center justify-center relative translate-x-[-12px]\">\n        \n        <div class=\"relative w-[320px] h-[320px] flex items-center justify-center\">\n\n          <!-- Outer Orbit Ring with state label (1px border) -->\n          <div class=\"absolute inset-[-18px] rounded-full border border-[rgba(245,158,11,0.25)] anim-orbit pointer-events-none flex items-start justify-center\">\n            <!-- State Badge mounted on orbit ring -->\n            <div class=\"bg-[#101215] border border-[#F59E0B] px-2.5 py-[2px] r