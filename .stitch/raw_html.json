der-x border-b border-[rgba(255,255,255,0.07)] rounded-[14px] px-6 flex items-center justify-between shadow-[0_12px_32px_rgba(0,0,0,0.55)] z-40\">\n    \n    <!-- Dock Left: Push-to-Talk Orb (56px) + Hotkey caption -->\n    <div class=\"flex items-center gap-3\">\n      <div class=\"relative flex items-center justify-center\">\n        <!-- 56px Orb button -->\n        <button class=\"w-[56px] h-[56px] rounded-full bg-[#15181C] border border-[#DC143C] hover:bg-[#DC143C]/20 flex items-center justify-center transition-all group relative shadow-[0_0_16px_rgba(220,20,60,0.25)]\">\n          <div class=\"w-8 h-8 rounded-full bg-[#DC143C]/20 flex items-center justify-center group-hover:scale-105 transition-transform\">\n            <i class=\"ph ph-microphone text-[20px] text-[#DC143C]\"></i>\n          </div>\n          <!-- subtle listening ping ring -->\n          <span class=\"absolute inset-0 rounded-full border border-[#DC143C] opacity-40 animate-ping\"></span>\n        </button>\n      </div>\n\n      <div class=\"flex flex-col\">\n        <span class=\"font-display font-semibold text-[11px] uppercase tracking-[0.08em] text-[#F2F4F7]\">Push to Talk</span>\n        <span class=\"font-mono text-[10px] text-[#9AA3AE] bg-[#15181C] border border-[rgba(255,255,255,0.07)] px-1.5 py-[1px] rounded-[3px] mt-0.5 inline-block w-fit\">\n          Ctrl+Alt+Space\n        </span>\n      </div>\n    </div>\n\n    <!-- Dock Centre: 32-Bar Live Spectrum in amber (2px bars, 2px gap) -->\n    <div class=\"flex flex-col items-center gap-1.5\">\n      <div class=\"flex items-end gap-[2px] h-[36px] px-4 py-1 bg-[#101215]/80 border border-[rgba(255,255,255,0.05)] rounded-[6px]\">\n        <!-- 32 bars with dynamic heights -->\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[8px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[14px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[22px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[18px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[28px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[12px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[32px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[26px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[16px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[20px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[34px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[28px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[24px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[18px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[30px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[35px]\"></div>\n        <!-- symmetry peak -->\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[32px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[25px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[19px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[27px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[33px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[22px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[15px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[28px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[30px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[18px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[12px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[24px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[16px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[10px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[6px]\"></div>\n        <div class=\"w-[2px] bg-[#F59E0B] rounded-none h-[4px]\"></div>\n      </div>\n      <span class=\"font-mono text-[10px] text-[#5C6570] tracking-wider uppercase\">60 HZ \u00b7 DSP AUDIO SPECTRUM</span>\n    </div>\n\n    <!-- Dock Right: 3 Quick Tools + Model Switcher -->\n    <div class=\"flex items-center gap-3\">\n      \n      <!-- Quick-tool tiles: AgentPhone, AgentMail, Sandbox Terminal -->\n      <div class=\"flex items-center gap-1.5\">\n        <!-- Tile 1: AgentPhone -->\n        <button class=\"flex flex-col items-center justify-center w-[60px] h-[52px] bg-[#15181C] hover:bg-[#1a1e24] border border-[rgba(255,255,255,0.07)] hover:border-[#DC143C]/60 rounded-[6px] transition-colors group\">\n          <i class=\"ph ph-phone-call text-[20px] text-[#9AA3AE] group-hover:text-[#F2F4F7]\"></i>\n          <span class=\"text-[11px] font-sans text-[#9AA3AE] group-hover:text-[#F2F4F7] mt-0.5\">Phone</span>\n        </button>\n\n        <!-- Tile 2: AgentMail -->\n        <button class=\"flex flex-col items-center justify-center w-[60px] h-[52px] bg-[#15181C] hover:bg-[#1a1e24] border border-[rgba(255,255,255,0.07)] hover:border-[#DC143C]/60 rounded-[6px] transition-colors group\">\n          <i class=\"ph ph-envelope-simple text-[20px] text-[#9AA3AE] group-hover:text-[#F2F4F7]\"></i>\n          <span class=\"text-[11px] font-sans text-[#9AA3AE] group-hover:text-[#F2F4F7] mt-0.5\">Mail</span>\n        </button>\n\n        <!-- Tile 3: Sandbox Terminal -->\n        <button class=\"flex flex-col items-center justify-center w-[60px] h-[52px] bg-[#15181C] hover:bg-[#1a1e24] border border-[rgba(255,255,255,0.07)] hover:border-[#DC143C]/60 rounded-[6px] transition-colors group\">\n          <i class=\"ph ph-terminal-window text-[20px] text-[#9AA3AE] group-hover:text-[#F2F4F7]\"></i>\n          <span class=\"text-[11px] font-sans text-[#9AA3AE] group-hover:text-[#F2F4F7] mt-0.5\">Terminal</span>\n        </button>\n      </div>\n\n      <div class=\"h-8 w-[1px] bg-[rgba(255,255,255,0.07)] mx-1\"></div>\n\n      <!-- Model Switcher Select -->\n      <div class=\"flex flex-col gap-1\">\n        <label class=\"font-display font-medium text-[9px] text-[#5C6570] uppercase tracking-[0.08em]\">Default Model</label>\n        <div class=\"relative\">\n          <select class=\"appearance-none bg-[#15181C] border border-[rgba(255,255,255,0.12)] hover:border-[#DC143C] text-[#F2F4F7] font-mono text-[11px] rounded-[4px] py-1.5 pl-2.5 pr-8 cursor-pointer focus:outline-none focus:border-[#DC143C] transition-colors\">\n            <option>Qwen3.5-0.8B \u00b7 fast</option>\n            <option>Qwen2.5-Coder-3B</option>\n            <option>Ministral-3B</option>\n            <option>Nemotron-30B-MoE</option>\n          </select>\n          <div class=\"pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-[#9AA3AE]\">\n            <i class=\"ph ph-caret-down text-[10px]\"></i>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n  </footer>\n\n</body>\n</html>\n"
