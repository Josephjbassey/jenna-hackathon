# Backend Environment Configuration for Jenna AI Assistant

# Meta Model API (SAM 3.1, Muse Spark 1.3, Muse Code)
META_MODEL_API_KEY=your_meta_api_key_here
META_MODEL_API_BASE=https://api.meta.ai/v1

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Database & Storage
DATABASE_URL=sqlite:///./memory/cross_agent.db
